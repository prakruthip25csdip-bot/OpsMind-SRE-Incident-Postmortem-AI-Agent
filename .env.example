# IncidentIQ - Environment Configuration Example

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Hindsight Persistent Memory Configuration
# For Hindsight Cloud: https://api.hindsight.vectorize.io
# For local instance: http://localhost:8888
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=incidentiq-bank
HINDSIGHT_TIMEOUT=60.0
# OpsMind Environment Configuration Template
PROJECT_NAME="OpsMind SRE & Incident Postmortem AI Agent"
ENVIRONMENT="development"
DEBUG=true

# Security
SECRET_KEY="replace-with-a-random-64-char-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite Async (default for instant run):
DATABASE_URL="sqlite+aiosqlite:///./opsmind.db"
# PostgreSQL Async for Production / Docker:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/opsmind"

# Groq LLM API Configuration
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_FALLBACK_MODEL="llama-3.1-8b-instant"
GROQ_TEMPERATURE=0.2

# Hindsight Persistent AI Memory Configuration
HINDSIGHT_API_URL="http://localhost:8888"
HINDSIGHT_API_KEY=""
HINDSIGHT_BANK_PREFIX="opsmind"
HINDSIGHT_AUTO_RETAIN=true

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://localhost:8000","*"]'

