# IncidentIQ - Environment Configuration Example

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Hindsight Persistent Memory Configuration
# For Hindsight Cloud: https://api.hindsight.vectorize.io
# For local instance: http://localhost:8888
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=incidentiq-bank
HINDSIGHT_TIMEOUT=60.0

